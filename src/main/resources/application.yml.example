spring:
  application:
    name: lavaradio
  grpc:
    server:
      address: 127.0.0.1
      port: 9090

lavaplayer:
  providers:
    - "ytsearch:\"%ISRC%\""
    - "dzsearch:%QUERY%"
    - "dzisrc:%ISRC%"
    - "ytsearch:%QUERY%"
  sources:
    spotify:
      clientId: ""
      clientSecret: ""
      countryCode: ""
      spDc: ""
    deezer:
      masterDecryptionKey: ""
      arl: ""
