spring:
  application:
    name: lavaradio
  grpc:
    server:
      address: 0.0.0.0
      port: ${KOTLIN_GRPC_PORT:9090}
  graphql:
    websocket:
      path: /graphql
    cors:
      allowed-origins: "*"
      allowed-methods: GET,POST
      max-age: 1800s

server:
  address: 0.0.0.0
  port: ${KOTLIN_SERVER_PORT:8080}

lavaplayer:
  providers:
    - "ytsearch:\"%ISRC%\""
    - "dzsearch:%QUERY%"
    - "dzisrc:%ISRC%"
    - "ytsearch:%QUERY%"
  sources:
    spotify:
      clientId: ""
      clientSecret: ""
      countryCode: ""
      spDc: ""
    deezer:
      masterDecryptionKey: ""
      arl: ""

webrtcgrpc:
 host: ${WEBRTC_GRPC_HOST:webrtc-bridge}
 port: ${WEBRTC_GRPC_PORT:50051}